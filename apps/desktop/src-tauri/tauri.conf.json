{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sotto",
  "version": "0.1.0",
  "identifier": "dev.sotto.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "notch",
        "title": "Sotto",
        "url": "index.html#/notch",
        "width": 440,
        "height": 38,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "shadow": false
      },
      {
        "label": "settings",
        "title": "Settings",
        "url": "index.html#/settings",
        "width": 1000,
        "height": 720,
        "minWidth": 560,
        "minHeight": 480,
        "center": true,
        "visible": false
      },
      {
        "label": "onboarding",
        "title": "Welcome to Sotto",
        "url": "index.html#/onboarding",
        "width": 960,
        "height": 700,
        "minWidth": 560,
        "minHeight": 480,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Productivity",
    "externalBin": [
      "binaries/sotto-audio"
    ],
    "resources": {
      "../../../fixtures/audio/*.wav": "clips/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "26.0",
      "entitlements": "entitlements.plist"
    }
  }
}
