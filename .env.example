# sotto-api configuration. Copy to .env for local runs; never commit real values.
DATABASE_URL=postgres://sotto:sotto@localhost:54329/sotto
BIND_ADDR=127.0.0.1:8080
# Base of the links in emails; https enables the Secure flag on the login cookie.
PUBLIC_BASE_URL=http://localhost:8080
# smtp://host:port is plain (Mailpit), smtps:// is implicit TLS, ?tls=required uses STARTTLS.
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Sotto <login@sotto.local>
# fake: returns a useless token so the app can be built for free. openai: mints real tokens.
REALTIME_PROVIDER=fake
# Required when REALTIME_PROVIDER=openai.
OPENAI_API_KEY=
# Optional. Defaults to https://api.openai.com; tests point it at a fake server.
OPENAI_BASE_URL=
# Optional. Transcription model for minted tokens (default gpt-live-transcribe).
OPENAI_TRANSCRIBE_MODEL=
# Optional. Log filter, default info,sqlx=warn.
RUST_LOG=info
